NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TELEGRAM_BOT_TOKEN=add-only-to-deployment-secret-store
TELEGRAM_WEBHOOK_SECRET=add-only-to-deployment-secret-store
# Optional: private group/chat where new customer support tickets are delivered.
SUPPORT_TELEGRAM_CHAT_ID=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=TruckProfit/0.1 (https://fleet-economics.vercel.app)
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_USER_AGENT=TruckProfit/0.1 (https://fleet-economics.vercel.app)
# Server-only key for automatic Google route alternatives. OSRM remains the fallback.
GOOGLE_ROUTES_API_KEY=
# Server-only key for the report AI analyst. Never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional override. The cost-efficient default is gpt-5-mini.
OPENAI_ANALYTICS_MODEL=gpt-5-mini
